# ====================================================
# Express Backend Configuration
# ====================================================
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/ai-learning-companion
JWT_SECRET=your_jwt_secret_key_here

# ====================================================
# OpenRouter LLM Configuration
# ====================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ====================================================
# Chroma Cloud Configurations
# ====================================================
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_name_here

# ====================================================
# RAG Service Configurations
# ====================================================
RAG_SERVICE_URL=http://localhost:8000
RAG_HOST=0.0.0.0
RAG_PORT=8000

UPLOAD_DIR=backend/uploads/documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

SITE_NAME=Jarvis
SITE_URL=http://localhost:5173
